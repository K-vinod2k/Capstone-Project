# Copy this file to .env and fill in your own values.
# NEVER commit .env — it is git-ignored.

# ── Anthropic Claude (Persona Brain LLM) ─────────────────────────────────────
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── NVIDIA Cosmos (Video Generation & NIMs) ──────────────────────────────────
# Get your key at: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# ── fal.ai (LTX-Video 2.3 text-to-video) ─────────────────────────────────────
# Get your key at: https://fal.ai/dashboard
FAL_KEY=your_fal_key_here

# ── Colab Pro (LTX-Video 2 local GPU — set this to skip fal.ai entirely) ─────
# Run LTX2_Colab.ipynb on Colab Pro, paste the ngrok URL printed by Cell 4
COLAB_URL=https://your-ngrok-url.ngrok-free.app

# ── fal.ai fallback (only used if COLAB_URL is not set) ──────────────────────
FAL_KEY=your_fal_key_here
